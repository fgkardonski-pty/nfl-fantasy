# ---- Gridiron Oracle configuration -------------------------------------------
# Copy to .env and fill in. Everything is optional except the Yahoo pair if you
# want live league data. The platform runs fully in demo mode with none of it.

# Server
ORACLE_PORT=4317
ORACLE_HOST=127.0.0.1
ORACLE_DB=./data/oracle.db

# Encryption key for at-rest OAuth token storage (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORACLE_SECRET=

# ---- Yahoo Fantasy Sports API ------------------------------------------------
# Create an app at https://developer.yahoo.com/apps/create/
#   Application Type : Web Application
#   Redirect URI     : http://localhost:4317/auth/yahoo/callback
#   API Permissions  : Fantasy Sports -> Read (or Read/Write to submit moves)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:4317/auth/yahoo/callback

# ---- Optional data providers -------------------------------------------------
# Vegas lines drive the game-environment component of projections.
# Free tier: https://the-odds-api.com
ODDS_API_KEY=

# Optional: lets the research daemon turn free-text news into structured
# projection impacts. https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- FantasyPros (draft rankings / ADP) --------------------------------------
# Free personal, NON-COMMERCIAL key, issued instantly: https://api.fantasypros.com
# Supplies the positional ranks the draft board needs — without rankings from
# some source, every player at a position is priced identically.
FANTASYPROS_API_KEY=

# Only set these if `oracle real fp-probe` shows the default endpoint is wrong.
# FANTASYPROS_API_BASE=https://api.fantasypros.com/public/v2/json
# FANTASYPROS_RANKINGS_PATH=/json/nfl/{season}/consensus-rankings?type=draft&scoring={scoring}&position=ALL&week=0
#
# Paging. The API returns a `count` in the hundreds but only ten players per
# response, and the published spec documents no paging parameter. Run
#   node bin/oracle.mjs real fp-page
# to find which name the backend actually honours, then set it here.
# STYLE is "size" (one request asks for everything), "offset" (row number) or
# "page" (page number).
# FANTASYPROS_PAGE_PARAM=limit
# FANTASYPROS_PAGE_STYLE=size
ORACLE_LLM_MODEL=claude-sonnet-5

# ---- Simulation tuning -------------------------------------------------------
ORACLE_SIMS_WEEK=20000
ORACLE_SIMS_SEASON=5000
ORACLE_SEED=8675309
