  "_draftOrder": "Seat order at the draft table, seat 1 first — read off Yahoo's draft results page: the first sixteen picks of round 1 name the sixteen seats in order. This is the ONLY thing connecting a pick to a manager. The pick log tells the app which SEAT made each pick, never who sat there, so without this list the opponents' rosters cannot be rebuilt and the war room, playoff odds and trade views have nothing to work with. Ours is seat 4.",
  "draftOrder": [],

  "_schedule": "Only weeks entered here are treated as the REAL schedule. Anything absent is filled by a division-aware round robin purely so the season simulation has something to run on — it is labelled as estimated in the app and must never be read as Yahoo's actual pairings. Add weeks as you read them off Yahoo; each week is a list of [home, away] name pairs.",
  "schedule": {
    "1": [["Frank the Tank", "Fly Agaric"]]
  },

  "_waivers": "Weekly rolling list based on standings — NOT FAAB. Continuous processing. faabBudget is therefore unused for bidding; waiver priority governs claims.",
  "waiverType": "priority",
  "faabBudget": 0,

  "scoring": {
    "_passing": "0.5/completion and 0.5/first down are the two categories generic rankings ignore entirely, and together they are worth ~19 pts/game to an elite QB.",
    "pass_cmp": 0.5,
    "pass_yd": 0.04,
    "pass_td": 6,
    "pass_int": -1,
    "pick_six_thrown": -2,
    "pass_first_down": 0.5,
    "pass_cmp_40": 2,
    "pass_td_40": 3,

    "_rushing": "0.2 per carry rewards volume backs beyond their yardage.",
    "rush_att": 0.2,
    "rush_yd": 0.1,
    "rush_td": 6,
    "rush_first_down": 0.5,
    "rush_40": 2,
    "rush_td_40": 3,

    "_receiving": "Half PPR, but the 0.5 first-down bonus pushes possession receivers close to full PPR in practice.",
    "rec": 0.5,
    "rec_yd": 0.1,
    "rec_td": 6,
    "rec_first_down": 0.5,
    "rec_40": 2,
    "rec_td_40": 3,

    "_misc": "CORRECTED from the manager's reading of the Yahoo tables: return yards score NOTHING for RB/WR/TE, and the QB line (10 yds/pt) is dead weight because quarterbacks do not return kicks. The only live return-yard rule in this league is the Defense/Special Teams one — 10 yards per point, i.e. def_ret_yd 0.1, plus +1 at 30 yards. Leave ret_yd at 0: setting it non-zero would silently inflate every skill player.",
    "ret_yd": 0,
    "ret_td": 6,
    "two_pt": 2,
    "fum_lost": -2,
    "fum_ret_td": 6,

    "_kicking": "Only sub-20 misses are penalised; longer misses cost nothing.",
    "fg_0_19": 3,
    "fg_20_29": 3,
    "fg_30_39": 3,
    "fg_40_49": 4,
    "fg_50p": 6,
    "fg_miss_0_19": -2,
    "pat_made": 1,

    "_defense": "Notably inflated vs Yahoo defaults: 2/sack (vs 1), 16 for a shutout (vs 10). Defenses are worth more here than in a standard league.",
    "def_sack": 2,
    "def_int": 2,
    "def_fum_rec": 2,
    "def_td": 6,
    "def_safety": 2,
    "def_block": 2,
    "def_ret_td": 6,
    "def_ret_yd": 0.1,
    "def_pa_0": 16,
    "def_pa_1_6": 8,
    "def_pa_7_13": 6,
    "def_pa_14_20": 2,
    "def_pa_21_27": 0,
